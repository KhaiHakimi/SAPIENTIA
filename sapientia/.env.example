# Copy to .env and replace the password. .env is git-ignored; never commit real values.

# Local PostgreSQL (docker-compose.yml)
POSTGRES_DB=sapientia
POSTGRES_USER=sapientia
POSTGRES_PASSWORD=replace-with-a-long-random-password
# A high port, so it never clashes with a PostgreSQL installed on the machine (5432).
POSTGRES_PORT=55432

# Used by the app and by node-pg-migrate. Keep it in step with the values above.
DATABASE_URL=postgres://sapientia:replace-with-a-long-random-password@localhost:55432/sapientia
# Integration tests empty their tables, so they use their own database (created by docker/initdb on a fresh volume).
TEST_DATABASE_URL=postgres://sapientia:replace-with-a-long-random-password@localhost:55432/sapientia_test

# Shared password for the fictional staff created by `npm run db:seed` (development only, at least 10 characters).
SEED_PASSWORD=replace-with-a-dev-only-password

# Public origin when a proxy sits in front (used for invite links and the CSRF check). Leave empty locally.
APP_ORIGIN=

# Notifications (Sprint 5). A channel whose variables are empty is switched off; the worker logs which.
# Email: locally, Mailpit from docker-compose.yml catches every message (inbox at http://localhost:8025).
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Sapientia <no-reply@sapientia.test>
# Web Push: generate a key pair once with `npx web-push generate-vapid-keys`. The private key is a secret: .env only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact the push services can reach about this sender (mailto: or https:).
VAPID_SUBJECT=mailto:admin@sapientia.test
