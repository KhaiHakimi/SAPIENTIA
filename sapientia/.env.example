# Copy to .env and replace the password. .env is git-ignored; never commit real values.

# Local PostgreSQL (docker-compose.yml)
POSTGRES_DB=sapientia
POSTGRES_USER=sapientia
POSTGRES_PASSWORD=replace-with-a-long-random-password
# A high port, so it never clashes with a PostgreSQL installed on the machine (5432).
POSTGRES_PORT=55432

# Used by the app and by node-pg-migrate. Keep it in step with the values above.
DATABASE_URL=postgres://sapientia:replace-with-a-long-random-password@localhost:55432/sapientia
# Integration tests empty their tables, so they use their own database (created by docker/initdb on a fresh volume).
TEST_DATABASE_URL=postgres://sapientia:replace-with-a-long-random-password@localhost:55432/sapientia_test

# Shared password for the fictional staff created by `npm run db:seed` (development only, at least 10 characters).
SEED_PASSWORD=replace-with-a-dev-only-password

# Public origin when a proxy sits in front (used for invite links and the CSRF check). Leave empty locally.
APP_ORIGIN=

# Notifications (Sprint 5). A channel whose variables are empty is switched off; the worker logs which.
# Email: locally, Mailpit from docker-compose.yml catches every message (inbox at http://localhost:8025).
SMTP_URL=smtp://localhost:1025
MAIL_FROM=Sapientia <no-reply@sapientia.test>
# Web Push: generate a key pair once with `npx web-push generate-vapid-keys`. The private key is a secret: .env only.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# A contact the push services can reach about this sender (mailto: or https:).
VAPID_SUBJECT=mailto:admin@sapientia.test

# Uploaded files (lesson photos, the material bank) are kept here, outside the web root. Default: .data/uploads.
# Must not be inside public/. On more than one server this needs shared storage (decision D5).
# UPLOAD_DIR=.data/uploads

# Two-step sign-in (gate G6): the key that encrypts authenticator secrets in the database. 32 random bytes, base64. Generate
# one with `node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"`. A secret: .env or a secrets
# manager only, never the repository. Without it, two-step sign-in is switched off. Changing it breaks every authenticator
# already set up (each person then needs an administrator to reset theirs).
MFA_ENCRYPTION_KEY=

# AI (Phase 6). Off unless AI_PROVIDER names a provider and a model is set; every screen works without it. Only Ollama is
# supported, so instructions stay on a machine you run. Names the school holds, emails and phone or MyKad-like numbers are
# removed before anything is sent. Example: install Ollama, run `ollama pull <model>`, then set the three lines below.
AI_PROVIDER=off
# OLLAMA_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=
# Outer limit on one request to the model, in milliseconds (1000 to 120000; default 20000).
# AI_TIMEOUT_MS=20000

# MCP server (Phase 6): read-only tools for AI assistants at /api/mcp, signed in with a personal access token each person
# makes on the Security page. Off unless set to on.
MCP_SERVER=off
# WebMCP experiment (Phase 6): offers read-only tools to an AI agent in a browser that supports navigator.modelContext.
# Read at build time. Off unless set to on.
NEXT_PUBLIC_WEBMCP=off
